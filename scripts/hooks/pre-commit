#!/bin/sh
# Public repo hygiene (see CLAUDE.md). Enable once per clone:
#   git config core.hooksPath scripts/hooks
#
# 1. The author email must be a GitHub noreply address.
# 2. No added line may contain an entry of .hygiene-denylist (local, gitignored:
#    the real hostnames, serials and names of your own install, one per line).

email="${GIT_AUTHOR_EMAIL:-$(git config user.email)}"
case "$email" in
  *@users.noreply.github.com) ;;
  *)
    echo "pre-commit: author email is not a GitHub noreply address." >&2
    echo "  git config user.email <id>+<login>@users.noreply.github.com" >&2
    exit 1 ;;
esac

denylist="$(git rev-parse --show-toplevel)/.hygiene-denylist"
[ -f "$denylist" ] || exit 0

patterns="$(mktemp)"
trap 'rm -f "$patterns"' EXIT
grep -v '^[[:space:]]*#' "$denylist" | grep -v '^[[:space:]]*$' > "$patterns"
[ -s "$patterns" ] || exit 0

hits="$(git diff --cached -U0 --no-color --no-ext-diff \
  | grep '^+' | grep -v '^+++ ' | grep -iFf "$patterns")"
if [ -n "$hits" ]; then
  echo "pre-commit: staged lines contain entries from .hygiene-denylist:" >&2
  printf '%s\n' "$hits" | cut -c1-160 >&2
  exit 1
fi
