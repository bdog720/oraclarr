# Oraclarr settings. Every variable starts with ORACLARR_.
# An instance exists once its _URL is set. Blank values are ignored, so leave
# the lines for services you don't run empty. README "Configuration" lists every field.

# Optional server settings (defaults shown)
# ORACLARR_TOOLSETS=media,downloads,transcode,library
# ORACLARR_TOOL_BUDGET_SECONDS=30
# ORACLARR_TIMEOUT_SECONDS=10

ORACLARR_SONARR_URL=
ORACLARR_SONARR_API_KEY=

ORACLARR_RADARR_URL=
ORACLARR_RADARR_API_KEY=

ORACLARR_SPORTARR_URL=
ORACLARR_SPORTARR_API_KEY=

ORACLARR_PROWLARR_URL=
ORACLARR_PROWLARR_API_KEY=

ORACLARR_QBITTORRENT_URL=
ORACLARR_QBITTORRENT_USERNAME=
ORACLARR_QBITTORRENT_PASSWORD=

ORACLARR_TDARR_URL=

ORACLARR_PROFILARR_URL=
ORACLARR_PROFILARR_API_KEY=

ORACLARR_JELLYFIN_URL=
ORACLARR_JELLYFIN_API_KEY=

ORACLARR_CLEANUPARR_URL=
ORACLARR_CLEANUPARR_API_KEY=

ORACLARR_NETDATA_URL=

# TrueNAS: https only (TrueNAS revokes keys sent over http). Use a read-only user's key.
ORACLARR_TRUENAS_URL=
ORACLARR_TRUENAS_API_KEY=
# ORACLARR_TRUENAS_VERIFY_TLS=false   # for TrueNAS's default self-signed certificate

# Docker: the read-only socket proxy in the same compose stack (README "Containers").
# Usually http://docker-proxy:2375
ORACLARR_DOCKER_URL=

# A second instance of the same type: pick any name and give it a _TYPE.
# ORACLARR_SONARR_ANIME_TYPE=sonarr
# ORACLARR_SONARR_ANIME_URL=
# ORACLARR_SONARR_ANIME_API_KEY=
